{
  "group": "rsample",
  "case": "use_hash_table",
  "args": {},
  "arrays": {
    "n": {
      "file": "n.bin",
      "dtype": "<f8",
      "shape": [
        54
      ]
    },
    "size": {
      "file": "size.bin",
      "dtype": "<f8",
      "shape": [
        54
      ]
    },
    "use_hash": {
      "file": "use_hash.bin",
      "dtype": "<i4",
      "shape": [
        54
      ]
    },
    "with_replace": {
      "file": "with_replace.bin",
      "dtype": "<i4",
      "shape": [
        54
      ]
    },
    "with_prob": {
      "file": "with_prob.bin",
      "dtype": "<i4",
      "shape": [
        54
      ]
    }
  },
  "versions": {
    "R": "R version 4.6.1 (2026-06-24 ucrt)",
    "platform": "x86_64-w64-mingw32",
    "datanugget": "1.5.0",
    "Rfast": "2.1.5.2",
    "lapack": "3.12.1",
    "blas": "Rblas.dll md5 5fe8258e86d8a1a52a6c3db05faa0225",
    "longdouble_digits": 64
  },
  "rng": {
    "kind": ["Mersenne-Twister", "Inversion", "Rejection"],
    "use_hash": "(n > 1e+07 && !replace && is.null(prob) && size <= n/2)",
    "sample_int": ["{", "    stopifnot(length(n) == 1L)", "    if (useHash) {", "        stopifnot(is.null(prob), !replace)", "        .Internal(sample2(n, size))", "    }", "    else .Internal(sample(n, size, replace, prob))", "}"]
  }
}
